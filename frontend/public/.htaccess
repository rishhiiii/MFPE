# SPA fallback for React Router on Apache/Hostinger.
# Without this, directly visiting or refreshing a route like /privacy-policy
# returns a 404 because Apache looks for a file at that path. This rewrites all
# non-file, non-directory requests back to index.html so React Router can handle them.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
