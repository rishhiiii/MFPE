# Frontend Env Variables
# Use your rzp_live_... key id in production (rzp_test_... for testing)
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id
# Deployed backend URL in production, e.g. https://api.yourdomain.com
VITE_API_URL=http://localhost:5000

# "Sign in with Google": OAuth 2.0 Client ID from Google Cloud Console
# (APIs & Services > Credentials). Same value as GOOGLE_CLIENT_ID in the backend.
VITE_GOOGLE_CLIENT_ID=
