# Backend Environment Variables
PORT=5000
MONGO_URI=your_mongodb_connection_string

# Razorpay (use rzp_live_... / live secret in production)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Secret configured in Razorpay Dashboard > Settings > Webhooks (subscribe to payment.captured)
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Auth (use a long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=your_jwt_secret

# CORS: comma-separated allowed frontend origins (blank = allow all)
ALLOWED_ORIGINS=

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# SMTP (Nodemailer) - used by the Contact form
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM_NAME=Your Business Name
EMAIL_FROM_ADDRESS=Your Business Name <you@yourdomain.com>
EMAIL_TO=where_contact_form_submissions_should_arrive@example.com
